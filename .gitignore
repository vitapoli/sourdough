# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
*.db
*.db-journal

# uploaded files
/public/uploads/

# reference materials
/references/

# claude code
/.claude/

# claude code config
AGENTS.md
CLAUDE.md
deploy.sh

# рабочие материалы (планы, доки, исходники постов) — не код приложения
/content/

# тяжёлые оригиналы картинок курса — сайт использует .webp
/public/course/*.jpeg
/public/course/*.jpg
