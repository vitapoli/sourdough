generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Закваска (у пользователя может быть несколько)
model Starter {
  id        String   @id @default(cuid())
  name      String   // Имя закваски (например "Ржаная")
  flour     String   // Тип муки (ржаная, пшеничная, и т.д.)
  createdAt DateTime @default(now())
  notes     String?  // Заметки

  feedings Feeding[]
}

// Запись о кормлении
model Feeding {
  id             String   @id @default(cuid())
  starterId      String
  starter        Starter  @relation(fields: [starterId], references: [id], onDelete: Cascade)
  fedAt          DateTime @default(now())
  starterAmount  Float?   // Количество закваски (г)
  flourAmount    Float?   // Количество муки (г)
  waterAmount    Float?   // Количество воды (г)
  flourType      String?  // Тип муки при кормлении
  temperature    Float?   // Температура в помещении
  notes          String?  // Заметки (запах, консистенция, и т.д.)
  photos         String?  // Фото закваски (JSON массив URL, макс. 4)
  // Данные наблюдения (заполняются опционально, когда пользователь записал результат)
  peakTimeHours  Float?   // Часов до пика
  readyTimeHours Float?   // Часов до готовности
  peakMultiplier Float?   // Во сколько раз увеличилась
}

// Рецепт хлеба
model Recipe {
  id          String   @id @default(cuid())
  title       String   // Название рецепта
  description String?  // Краткое описание
  flour       String   // Тип муки
  hydration   Int      // Процент гидратации
  starterPct  Int      // Процент закваски
  salt        Float?   // Соль (г)
  ingredients   String?  // Все ингредиенты (JSON: [{name, amount, unit, phase?}])
  hydrationCalc String?  // Расчёт гидратации (JSON: {totalFlour, flourItems, totalLiquid, liquidItems, formula})
  steps       String   // Шаги приготовления (JSON)
  photos      String?  // Фото рецепта (JSON массив URL, макс. 3)
  previewHidden String?  // Скрытые поля превью (JSON: ["flour","starter","hydration"])
  isBuiltIn   Boolean  @default(false) // Встроенный рецепт или пользовательский
  pinned      Boolean  @default(false) // Закреплённый рецепт (показывается сверху)
  hidden      Boolean  @default(false) // Скрытый рецепт (не показывается в основном списке)
  sortOrder   Int      @default(0)     // Порядок сортировки (меньше = выше)
  parentId    String?  // ID оригинального рецепта (для вариантов)
  parent      Recipe?  @relation("RecipeVariants", fields: [parentId], references: [id], onDelete: SetNull)
  variants    Recipe[] @relation("RecipeVariants")
  createdAt   DateTime @default(now())
}
